{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "WEB_HOST",
    "WEB_PORT",
    "API_HOST",
    "API_PORT",
    "DATABASE_URL",
    "REDIS_URL",
    "MONGODB_URI",
    "MONGODB_DB_NAME",
    "AUTH_SECRET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "FANGYU_SITES_PREVIEW"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
