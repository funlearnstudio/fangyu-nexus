    "@fangyu/game-rules": "workspace:*",
    "@fangyu/observability": "workspace:*",
    "@fangyu/parsers-wasm": "workspace:*",
    "@fangyu/worker-ping": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/swagger": "11.2.1",
    "bullmq": "5.61.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.6.1",
    "ioredis": "5.8.1",
    "postgres": "3.4.7",
